# Copy to deploy/compose.env (gitignored) and run:
#   docker compose --env-file deploy/compose.env -f deploy/docker-compose.yml up -d
REGISTRY=aimlab
TAG=dev
HF_TOKEN=hf_...
GATEWAY_API_TOKEN=change-me
GATEWAY_BIND=127.0.0.1:8090
TISSUE_BIND=127.0.0.1:8010
SLIDES_DIR=/data/omero/data
# host prefix (what OMERO.web sends) -> container mount
SLIDE_PATH_MAP=/data/omero/data=/slides
MODELS_DIR=/data/models
HF_CACHE_DIR=/data/models/hf-cache
GPU_DEEPLIIF=0
GPU_HOVERNET=1
GPU_EC=2
GPU_PDAC=3
GPU_TISSUE=0
